# Copy this file to .env and fill it in. .env is git-ignored; never commit real values.

# Passwords for the MySQL container. Any long random strings will do.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Optional. Without a key, the app and the bots use the offline brain.
GEMINI_API_KEY=
GEMINI_MODEL=
BRAIN_MODE=

# The site is served at http://localhost:8080 unless changed here.
WEB_PORT=8080

# Optional. Password reset emails go through Gmail with an app password
# (Google Account > Security > 2-Step Verification > App passwords).
# Without these, the emails are written to the backend log instead.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
