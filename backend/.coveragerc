# Coverage is scoped to the AUTHENTICATION code under test:
#   utils.py, services.py, routes/auth.py
# Everything else (non-auth routes, app wiring, seeds, tests, venv) is omitted
# so the percentage reflects auth coverage specifically.
[run]
source = .
omit =
    venv/*
    test/*
    routes/feed.py
    routes/posts.py
    routes/users.py
    routes/__init__.py
    app.py
    config.py
    db.py
    mock_db.py
    seed.py

[report]
fail_under = 85
show_missing = True
