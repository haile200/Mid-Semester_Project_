# Installs to /etc/systemd/system/bot-worker.service on the EC2 host.
# Runs separately from backend.service so a crash or restart in one never affects the other.
[Unit]
Description=Bot worker (makes the bot accounts post, comment and reply)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/Mid-Semester_Project_/backend
ExecStart=/home/ec2-user/Mid-Semester_Project_/backend/venv/bin/python -m bots.worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
